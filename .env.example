# This is an example of your .env file format, which pnpm db:setup will create.
# Note: this must be .env, not .env.local, without further configuration changes.

# Deployment mode: 'full' (default) for complete SaaS or 'minimal' for landing page only
# Use 'minimal' for quick deployments without auth, database, or Stripe integration
DEPLOYMENT_MODE=full

# Database
POSTGRES_URL=postgresql://***

# Stripe (not needed in minimal mode)
MOCK_STRIPE=true
STRIPE_SECRET_KEY=sk_test_***
STRIPE_WEBHOOK_SECRET=whsec_***

# Site Configuration
BASE_URL=http://localhost:3000
AUTH_SECRET=***
